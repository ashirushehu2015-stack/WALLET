PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wallet_db?schema=public"
JWT_SECRET="your_super_secret_jwt_key_must_be_at_least_32_characters_long"

# Cryptographic Key Separation (AES-256-GCM & Keyed HMAC)
ENCRYPTION_KEY="64_hex_chars_representing_32_byte_aes_256_gcm_symmetric_key"
OTP_HMAC_SECRET="at_least_32_characters_dedicated_secret_for_otp_hmac_signing"

# CORS Whitelist (Comma-separated origins for production)
CORS_ALLOWED_ORIGINS="https://app.mangapay.ng,https://admin.mangapay.ng,https://portal.mangapay.ng"

PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_BASE_URL="https://api.paystack.co"

# VTpass VTU & VAS Gateway Configuration
VTPASS_BASE_URL="https://sandbox.vtpass.com/api"
VTPASS_API_KEY="your_vtpass_api_key"
VTPASS_SECRET_KEY="your_vtpass_secret_key"
VTPASS_PUBLIC_KEY="your_vtpass_public_key"
VTPASS_ENVIRONMENT="sandbox"
